# Copy to .env and adjust for your local setup.
# This file is committed; .env is gitignored.

# Auth.js (generate your own secret, e.g. `npx auth secret`):
AUTH_SECRET="replace-me"
# Optional. Set to the deployment's public origin (e.g. "https://app.example.com")
# when the platform does not infer it correctly; auto-detected otherwise.
# AUTH_URL="https://<your-deployment-host>"
# Only set "true" when this deployment runs behind a controlled proxy that
# overwrites forwarded host headers. Enabling it lets clients spoof the host,
# so leave it unset unless you own and sanitize those headers.
# AUTH_TRUST_HOST="true"

# Login throttling uses the client IP only when this deployment sits behind a
# proxy you control that *overwrites* (not appends to) the named header below;
# otherwise throttling falls back to username-only. Leave both unset otherwise.
# TRUST_PROXY="true"
# TRUSTED_CLIENT_IP_HEADER="cf-connecting-ip"  # e.g. cf-connecting-ip or x-forwarded-for

# MySQL (default for local development):
DATABASE_URL="mysql://root:password@localhost:3306/webquiz_v2"

# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO):
# "auto" is R2/S3-compatible only; AWS S3 needs the real region (e.g. "us-east-1").
S3_REGION="auto"
# Set only for S3-compatible providers (R2/MinIO). Omit for AWS S3.
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"
S3_BUCKET="webquiz-v2"
# "true" forces path-style addressing (typical for R2/MinIO). Defaults to true when S3_ENDPOINT is set.
S3_FORCE_PATH_STYLE="true"
# Public/CDN base URL used to build read URLs without presigning.
S3_PUBLIC_URL="https://cdn.example.com"
