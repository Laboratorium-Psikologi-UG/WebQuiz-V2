# Copy to .env and adjust for your local setup.
# This file is committed; .env is gitignored.

# Auth.js (generate your own secret, e.g. `npx auth secret`):
AUTH_SECRET="replace-me"

# MySQL (default for local development):
DATABASE_URL="mysql://root:password@localhost:3306/webquiz_v2"

# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO):
S3_REGION="auto"
# Set only for S3-compatible providers (R2/MinIO). Omit for AWS S3.
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"
S3_BUCKET="webquiz-v2"
# "true" forces path-style addressing (typical for R2/MinIO). Defaults to true when S3_ENDPOINT is set.
S3_FORCE_PATH_STYLE="true"
# Public/CDN base URL used to build read URLs without presigning.
S3_PUBLIC_URL="https://cdn.example.com"
